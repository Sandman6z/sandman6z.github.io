---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> HELLO, WORLD. / 你好，世界。</p>
      <h1>我是 Sandman。<br />把<span class="highlight">折腾</span>，<br />变成一点东西。</h1>
      <p class="hero-description">这里是我的互联网小据点。<br />写代码、记笔记，也分享那些值得留下的尝试。</p>
      <div class="actions"><a class="button primary" href="/projects/">看看我做的东西 <span>↗</span></a><a class="text-link" href="/about/">认识一下 →</a></div>
    </div>
    <div class="desk" aria-label="一张记录着保持好奇的便笺">
      <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="note"><span class="note-top">NOTE TO SELF <span>001</span></span><div class="asterisk" aria-hidden="true">✳</div><p>保持好奇。<br />允许自己<br /><span>慢慢变好。</span></p><div class="note-bottom"><span>SANDMAN'S DESK</span><span>↗</span></div></div>
      <span class="desk-caption">想法不必完美，先动手再说。</span>
    </div>
  </section>
  <section class="section">
    <div class="section-heading"><div><span class="eyebrow">01 / BUILD</span><h2>正在做的东西<span class="accent">.</span></h2></div><a class="text-link" href="/projects/">项目详情 ↗</a></div>
    <a href="/projects/#personal-site" class="project-card"><div class="project-art" aria-hidden="true"><span class="code-label">~/sandman</span><div class="window"><div class="window-bar"><i></i><i></i><i></i></div><div class="window-code"><span class="code-muted">// 一个新的开始</span><br /><span class="code-key">const</span> website = &#123;<br />&nbsp; curiosity: <span class="code-lime">true</span>,<br />&nbsp; status: <span class="code-lime">'building'</span><br />&#125;;<span class="cursor">▍</span></div></div><span class="art-number">01</span></div><div class="project-info"><span class="pill">个人项目 · 持续迭代</span><h3>个人网站，重新出发。 <span>↗</span></h3><p>把两代网站合并，重新整理内容与结构。给代码、笔记和想法，一个共同的落脚点。</p><div class="tags"><span>Astro</span><span>TypeScript</span><span>Markdown</span></div></div></a>
  </section>
  <section class="section writing">
    <div class="section-heading"><div><span class="eyebrow">02 / WRITE</span><h2>最近写下的<span class="accent">.</span></h2></div><a class="text-link" href="/blog/">全部文章 ↗</a></div>
    {posts.length ? posts.map(post => <a class="post-row" href={`/blog/${post.id}/`}><time>{post.data.date.toISOString().slice(0,10)}</time><h3>{post.data.title}</h3><span>↗</span></a>) : <div class="empty-writing"><span class="empty-mark" aria-hidden="true">[ … ]</span><div><h3>笔记正在整理，想法还在生长。</h3><p>第一篇正式文章，留给下一次认真分享。</p></div><a href="/blog/" class="text-link">去文章页 →</a></div>}
  </section>
  <section class="elsewhere"><div><span class="eyebrow">03 / CONNECT</span><h2>也可以在这里找到我。</h2></div><div class="social-links">{site.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name} ↗</a>)}</div></section>
</Base>
