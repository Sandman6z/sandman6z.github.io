---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() { return (await getCollection('posts', ({data}) => !data.draft)).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description}><header class="article-header"><a class="text-link" href="/blog/">← 返回文章</a><p class="eyebrow">{post.data.date.toISOString().slice(0,10)}</p><h1>{post.data.title}</h1><p class="lede">{post.data.description}</p><div class="tags">{post.data.tags.map((tag: string) => <span>{tag}</span>)}</div></header><div class="article-grid"><article class="prose"><Content /></article>{headings.some(h => h.depth === 2) && <aside class="toc"><span class="eyebrow">本篇目录</span>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</aside>}</div></Base>
