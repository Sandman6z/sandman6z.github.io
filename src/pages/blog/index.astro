---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<Base title="文章"><section class="page-intro"><p class="eyebrow">WRITING / 记录与分享</p><h1>写下来，<br /><span class="highlight">才算真的想过。</span></h1><p class="lede">技术笔记、实践记录，还有一点不设限的好奇心。</p></section>
{posts.length > 0 ? <section class="blog-list"><div class="search-bar"><label for="search">搜索文章</label><input id="search" type="search" placeholder="输入标题、标签或关键词" /><label for="tag">标签</label><select id="tag"><option value="">全部</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></div><p id="result-count" class="muted" role="status">共 {posts.length} 篇文章</p><div id="posts">{posts.map(post => <article class="blog-item" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLocaleLowerCase()} data-tags={JSON.stringify(post.data.tags)}><time>{post.data.date.toISOString().slice(0,10)}</time><h2><a href={`/blog/${post.id}/`}>{post.data.title} ↗</a></h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div><p id="no-results" hidden>没有找到相关文章，试试其他关键词。</p></section> : <section class="empty-state"><span class="eyebrow">WORK IN PROGRESS</span><h2>先把笔记理一理。</h2><p>旧站的文章提纲已经留下，正在等待进一步完善。<br />有了值得分享的内容，就会出现在这里。</p><a class="text-link" href="/projects/">先看看正在做的项目 →</a></section>}
</Base>
<script>
const search = document.querySelector<HTMLInputElement>('#search');
const tag = document.querySelector<HTMLSelectElement>('#tag');
const items = [...document.querySelectorAll<HTMLElement>('.blog-item')];
function filter() {
  const query = (search?.value || '').trim().toLocaleLowerCase();
  let count = 0;
  items.forEach(item => { const tags: string[] = JSON.parse(item.dataset.tags || '[]'); const visible = (item.dataset.search || '').includes(query) && (!tag?.value || tags.includes(tag.value)); item.hidden = !visible; if (visible) count++; });
  const status = document.querySelector('#result-count'); if (status) status.textContent = `共 ${count} 篇文章`;
  const empty = document.querySelector<HTMLElement>('#no-results'); if (empty) empty.hidden = count !== 0;
}
search?.addEventListener('input', filter); tag?.addEventListener('change', filter);
</script>
